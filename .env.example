# Browser-facing API URL. Production public-site should use the same-origin proxy:
# NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Server-side upstream used by the public-site proxy and media route.
NUXT_API_UPSTREAM_BASE=http://host.docker.internal:8000/api/v1

NUXT_PUBLIC_SITE_URL=http://localhost:3001
