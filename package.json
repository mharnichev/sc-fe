{
  "name": "barbershop-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:barbershop": "pnpm --filter @apps/barbershop dev",
    "dev:blog": "pnpm --filter @apps/blog dev",
    "dev:shop": "pnpm --filter @apps/shop dev",
    "dev:backoffice": "pnpm --filter @apps/backoffice dev",
    "dev:backoffice:network": "pnpm --filter @apps/backoffice dev:network",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vite": "^7.3.5",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "postcss@<=8.5.11": "8.5.22"
    }
  }
}
